{
  "name": "claudelens-app",
  "version": "1.6.0",
  "description": "ClaudeLens — GUI for Claude Code data",
  "author": "Giulio Di Giamberardino",
  "license": "MIT",
  "homepage": "https://github.com/giulio333/ClaudeLens#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/giulio333/ClaudeLens.git"
  },
  "bugs": {
    "url": "https://github.com/giulio333/ClaudeLens/issues"
  },
  "keywords": [
    "claude",
    "claude-code",
    "electron",
    "react",
    "developer-tools",
    "macos"
  ],
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"tsc -p tsconfig.electron.json -w\" \"wait-on http://localhost:5173 dist-electron/main.js && electron .\"",
    "dev:electron": "tsc -p tsconfig.electron.json -w",
    "build": "tsc -p tsconfig.electron.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "electron:build": "electron-builder",
    "memory-stats": "npx ts-node ../scripts/memory-stats.ts",
    "screenshot": "SCREENSHOT_MODE=true concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\""
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-query": "^5.100.14",
    "chokidar": "^3.6.0",
    "glob": "^13.0.6",
    "highlight.js": "^11.11.1",
    "js-yaml": "^4.1.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "rehype-highlight": "^7.0.2",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.19.19",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.5.0",
    "concurrently": "^8.2.2",
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^15.15.0",
    "postcss": "^8.5.15",
    "prettier": "^3.8.3",
    "tailwindcss": "^3.4.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "vite": "^5.3.1",
    "vite-plugin-electron": "^0.29.1",
    "vitest": "^2.1.9",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.claudelens.app",
    "productName": "ClaudeLens",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "icon4.icns",
      "icon.png"
    ],
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "./icon4.icns"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "./icon.png",
      "category": "Development"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "./icon.png"
    }
  }
}
